    },
    {
      "id": "modified_evidence_id",
      "target": "evidence_record.evidence_id",
      "operation": "flip_last_hex_digest",
      "prefix": "ev1-"
    },
    {
      "id": "wrong_target_type",
      "target": "evidence_record.target_type",
      "operation": "replace_type",
      "rule": "number if original type is not number; otherwise string"
    },
    {
      "id": "canonical_value_mutation",
      "target": "canonical_entry.scalar_at_json_pointer",
      "operation": "mutate_scalar",
      "rules": {
        "string": "append ' [TAMPERED]'",
        "boolean": "logical NOT",
        "number": "add 1",
        "null": "replace with string 'TAMPERED'"
      }
    },
    {
      "id": "deleted_anchor",
      "target": "runtime evidence indexes",
      "operation": "delete_anchor",
      "rule": "remove evidence_id index and (entry_id,json_pointer) index"
    }
  ],
  "case_construction": {
    "order": "corruption_classes in listed order × samples in listed order",
