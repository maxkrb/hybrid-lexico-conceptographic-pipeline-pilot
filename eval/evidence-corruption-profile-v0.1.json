  "corruption_classes": [
    {
      "id": "bad_json_pointer",
      "target": "evidence_record.json_pointer",
      "operation": "append_literal",
      "literal": "/__missing__"
    },
    {
      "id": "stale_content_sha256",
      "target": "evidence_record.content_sha256",
