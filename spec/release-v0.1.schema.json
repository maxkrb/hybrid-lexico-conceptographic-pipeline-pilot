{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/release-v0.1.schema.json",
  "title": "SUM-20 pilot release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","release_id","dataset_id","release_sequence","entry_schema_version","canonicalization","hash_algorithm","entry_count","content_hash_manifest","merkle_profile","entries","merkle_root"],
  "properties": {
    "schema_version": {"const": "release-v0.1"},
    "release_id": {"type": "string", "pattern": "^sum20-hist-ap-pilot-r[0-9]{3}$"},
    "dataset_id": {"const": "sum20-hist-ap-pilot-v0"},
    "release_sequence": {"type": "integer", "minimum": 1},
    "entry_schema_version": {"const": "lex-entry-v0.4"},
    "canonicalization": {"const": "RFC8785-JCS"},
    "hash_algorithm": {"const": "SHA-256"},
    "entry_count": {"type": "integer", "minimum": 1},
    "content_hash_manifest": {"const": "data/pilot/pre-release/content-hashes.json"},
    "merkle_profile": {"const": "merkle-profile-v0.1"},
    "entries": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"type": "object","additionalProperties": false,"required": ["entry_id","content_sha256"],"properties": {"entry_id": {"type": "string", "pattern": "^sum20-hist-ap-[0-9]{3}$"},"content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
