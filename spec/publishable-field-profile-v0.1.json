{
  "profile_id": "publishable-field-profile-v0.1",
  "description": "Deterministic selection of atomic public-output fields for P1 evidence binding.",
  "include_rules": [
    {"kind": "exact", "json_pointer": "/lemma/display", "field_class": "lemma_display"},
    {"kind": "exact", "json_pointer": "/grammar/pos", "field_class": "grammar_pos"},
    {"kind": "exact", "json_pointer": "/def_short", "field_class": "def_short"},
    {"kind": "recursive_key", "root": "/senses", "key": "definition", "field_class": "definition"},
    {"kind": "recursive_key", "root": "/phrases", "key": "definition", "field_class": "phrase_definition"},
    {"kind": "recursive_example_text", "key": "text", "field_class": "example_text"},
    {"kind": "top_level_phrase_display", "root": "/phrases", "key": "display", "field_class": "phrase_display"}
  ],
  "exclude_from_v0_1": ["labels_source","source_ref","morphology_source","cross_references","lemma variants","internal identifiers","source/provenance metadata"],
  "selection_constraints": {"scalar_targets_only": true,"null_definitions_are_skipped": true,"record_order": "entry_id ascending, then json_pointer lexicographic"}
}
