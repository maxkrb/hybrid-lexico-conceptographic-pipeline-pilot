    {"phrase_id": "sum20-hist-ap-013-p2", "display": "Прошу́ люби́ти й шанува́ти (жа́лувати)", "marker_source": "◇", "labels_source": [], "definition": null, "examples": [], "cross_references": [{"relation": "see", "target_display": "проси́ти"}]}
  ]
